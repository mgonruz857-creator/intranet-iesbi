{
  "name": "intranet-iesbi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p .",
    "test:convivencia": "for f in pruebas/convivencia/*.test.mts; do echo \"== $f\"; tsx \"$f\" || exit 1; done",
    "test:seguridad": "tsx pruebas/convivencia/seguridad.ts",
    "test:salidas": "node --experimental-strip-types --no-warnings --test pruebas/salidas/servidor.test.mjs pruebas/salidas/horario.test.mts",
    "test": "npm run test:convivencia && npm run test:salidas && npm run test:acceso",
    "test:acceso": "tsx pruebas/acceso_unico.test.mts"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
